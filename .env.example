# Web3Forms access key (public by design). Copy to .env.local and fill in.
REACT_APP_WEB3FORMS_KEY=

# Tiny Wars war server (optional). Leave empty for practice mode.
REACT_APP_TINYWARS_API=

# Live visitor and player stats (optional). See supabase/schema.sql.
# Project Settings -> API: Project URL and the "anon public" key (public by design).
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
